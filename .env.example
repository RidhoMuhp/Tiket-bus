# Supabase: ambil kedua nilai ini dari Dashboard > Connect > App Frameworks > React.
# Publishable key aman dipakai di browser bila RLS pada supabase/schema.sql telah dijalankan.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Konfigurasi aplikasi lama (dipakai hanya bila Supabase belum dikonfigurasi).
PORT=3002
VITE_API_BASE_URL=http://localhost:3002/api
VITE_DEMO_MODE=true
VITE_WHATSAPP_ADMIN_NUMBER=6285179557691
WHATSAPP_ADMIN_NUMBER=6285179557691

# Pilihan: sqlite atau mysql
DB_CLIENT=sqlite
SQLITE_FILE=./bustara.db

# Ubah DB_CLIENT menjadi mysql dan isi nilai berikut saat MySQL siap digunakan.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bustara
